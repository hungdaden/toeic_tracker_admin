{
  "name": "toeic-tracker-admin",
  "version": "1.0.0",
  "description": "TOEIC Tracker Admin Suite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Hung Den",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.hungden.toeic.admin",
    "productName": "Toeic Tracker Admin",
    "directories": {
      "output": "../build/desktop"
    },
    "files": [
      "main.js",
      "index.html",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Toeic Tracker Admin",
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "../build/desktop"
    }
  }
}
